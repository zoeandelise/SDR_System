# 环境配置示例文件
# 复制此文件为 config.env 并修改相应配置

# 应用配置
DEBUG=true
HOST=0.0.0.0
PORT=8001

# 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=ry-vue

# MongoDB配置
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=diet_system

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ML模型配置
MODEL_PATH=./models/saved/
BATCH_SIZE=64
LEARNING_RATE=0.001
N_EPOCHS=100

# 协同过滤配置
CF_N_FACTORS=50
CF_N_EPOCHS=20
CF_LR=0.005
CF_REG=0.02

# 内容推荐配置
CONTENT_MIN_SIMILARITY=0.1
CONTENT_MAX_RECOMMENDATIONS=50

# 深度学习配置
DL_EMBEDDING_DIM=64
DL_HIDDEN_DIMS=128,64,32
DL_DROPOUT_RATE=0.3

# 缓存配置
CACHE_TTL=3600
CACHE_PREFIX=ml_diet_rec:

# 性能配置
MAX_WORKERS=4
REQUEST_TIMEOUT=30
