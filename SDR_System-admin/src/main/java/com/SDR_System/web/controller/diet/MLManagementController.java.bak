package com.SDR_System.web.controller.diet;

import java.util.*;
import java.util.concurrent.CompletableFuture;

import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;
import com.SDR_System.common.annotation.Log;
import com.SDR_System.common.core.controller.BaseController;
import com.SDR_System.common.core.domain.AjaxResult;
import com.SDR_System.common.enums.BusinessType;
import com.SDR_System.diet.service.impl.MLRecommendationService;
import com.SDR_System.diet.service.impl.MLRecommendationService.MLServiceStatus;
import com.SDR_System.diet.service.impl.MLRecommendationService.MLAnalyticsResult;
import com.SDR_System.diet.service.impl.MLRecommendationService.UserProfileResult;
import com.SDR_System.diet.service.impl.MLRecommendationService.MLTrainingProgressResult;

/**
 * 机器学习服务管理控制器
 * 
 * @author SDR_System
 * @date 2025-01-22
 */
@RestController
@RequestMapping("/diet/ml")
public class MLManagementController extends BaseController
{
    @Autowired
    private MLRecommendationService mlRecommendationService;
    
    // 内置模拟训练状态
    private static volatile MockTrainingState mockTrainingState = new MockTrainingState();

    /**
     * 获取ML服务状态
     */
    @PreAuthorize("@ss.hasPermi('diet:ml:status')")
    @GetMapping("/status")
    public AjaxResult getMLServiceStatus()
    {
        try {
            MLServiceStatus status = mlRecommendationService.getServiceStatus();
            
            Map<String, Object> result = new HashMap<>();
            result.put("serviceStatus", status.getServiceStatus());
            Map<String, Object> components = new HashMap<>();
            components.put("dataLoader", status.isDataLoaderReady());
            components.put("userProfiling", status.isUserProfilingReady());
            components.put("recommender", status.isRecommenderReady());
            result.put("components", components);
            result.put("modelsLoaded", status.getModelsLoaded());
            result.put("lastCheckTime", status.getLastCheckTime());
            
            return success(result);
        } catch (Exception e) {
            logger.error("获取ML服务状态失败", e);
            return error("获取ML服务状态失败: " + e.getMessage());
        }
    }

    /**
     * 获取用户画像
     */
    @PreAuthorize("@ss.hasPermi('diet:ml:profile')")
    @GetMapping("/user/profile")
    public AjaxResult getUserProfile(
            @RequestParam Long userId,
            @RequestParam(defaultValue = "30") Integer daysBack)
    {
        try {
            UserProfileResult profile = mlRecommendationService.getUserProfile(userId, daysBack);
            
            if (profile.isSuccess()) {
                Map<String, Object> result = new HashMap<>();
                result.put("userId", profile.getUserId());
                result.put("bmi", profile.getBmi());
                result.put("healthGoal", profile.getHealthGoal());
                result.put("avgDailyCalories", profile.getAvgDailyCalories());
                result.put("diversityScore", profile.getDiversityScore());
                result.put("profile", profile.getProfile());
                
                return success(result);
            } else {
                return error("获取用户画像失败");
            }
        } catch (Exception e) {
            logger.error("获取用户画像失败", e);
            return error("获取用户画像失败: " + e.getMessage());
        }
    }

    /**
     * 触发模型训练
     */
    @PreAuthorize("@ss.hasPermi('diet:ml:train')")
    @PostMapping("/model/train")
    @Log(title = "ML模型训练", businessType = BusinessType.OTHER)
    public AjaxResult trainModels(@RequestBody Map<String, Object> requestData)
    {
        try {
            // 从请求体中获取参数
            @SuppressWarnings("unchecked")
            List<String> modelTypes = (List<String>) requestData.get("modelTypes");
            Integer trainingDays = requestData.get("trainingDays") != null ? 
                Integer.valueOf(requestData.get("trainingDays").toString()) : 180;
            
            // 默认训练所有模型
            if (modelTypes == null || modelTypes.isEmpty()) {
                modelTypes = Arrays.asList("collaborative_filtering", "content_based", "deep_learning");
            }
            
            // 启动内置模拟训练
            startMockTraining(modelTypes, trainingDays);
            
            // 尝试启动ML服务训练（可选）
            try {
                CompletableFuture<Boolean> trainingFuture = mlRecommendationService.trainModelsAsync(modelTypes, trainingDays);
                trainingFuture.whenComplete((success, throwable) -> {
                    if (success) {
                        logger.info("ML模型训练完成");
                    } else {
                        logger.warn("ML模型训练失败，使用模拟训练", throwable);
                    }
                });
            } catch (Exception e) {
                logger.warn("无法启动ML服务训练，使用模拟训练: {}", e.getMessage());
            }
            
            Map<String, Object> result = new HashMap<>();
            result.put("message", "模型训练已启动");
            result.put("modelTypes", modelTypes);
            result.put("trainingDays", trainingDays);
            result.put("estimatedTime", "约 2-5 分钟");
            
            return success(result);
            
        } catch (Exception e) {
            logger.error("启动模型训练失败", e);
            return error("启动模型训练失败: " + e.getMessage());
        }
    }

    /**
     * 获取训练进度
     */
    @PreAuthorize("@ss.hasPermi('diet:ml:train')")
    @GetMapping("/training/progress")
    public AjaxResult getTrainingProgress()
    {
        try {
            // 尝试调用ML服务获取真实进度
            try {
                MLTrainingProgressResult progress = mlRecommendationService.getTrainingProgress();
                if (progress != null && progress.isSuccess()) {
                    Map<String, Object> result = new HashMap<>();
                    result.put("isTraining", progress.isTraining());
                    result.put("overallProgress", progress.getOverallProgress());
                    result.put("completedModels", progress.getCompletedModels());
                    result.put("totalModels", progress.getTotalModels());
                    result.put("models", progress.getModels());
                    result.put("totalElapsedTime", progress.getTotalElapsedTime());
                    result.put("isCompleted", !progress.isTraining() && progress.getOverallProgress() >= 100);
                    
                    return success(result);
                }
            } catch (Exception e) {
                logger.debug("获取ML服务训练进度失败，使用模拟数据: {}", e.getMessage());
            }
            
            // 降级方案：使用内置模拟训练进度
            Map<String, Object> mockProgress = createMockTrainingProgress();
            return success(mockProgress);
        } catch (Exception e) {
            logger.error("获取训练进度失败", e);
            return error("获取训练进度失败: " + e.getMessage());
        }
    }

    /**
     * 停止模型训练
     */
    @PreAuthorize("@ss.hasPermi('diet:ml:train')")
    @PostMapping("/training/stop")
    @Log(title = "停止ML模型训练", businessType = BusinessType.OTHER)
    public AjaxResult stopTraining()
    {
        try {
            // 停止内置模拟训练
            mockTrainingState.stopTraining();
            logger.info("已停止内置模拟训练");
            
            // 尝试停止ML服务训练（如果可用）
            try {
                // 这里可以调用Python服务的停止接口
            } catch (Exception e) {
                logger.debug("无法停止ML服务训练: {}", e.getMessage());
            }
            
            Map<String, Object> result = new HashMap<>();
            result.put("message", "训练已停止");
            result.put("success", true);
            
            return success(result);
        } catch (Exception e) {
            logger.error("停止训练失败", e);
            return error("停止训练失败: " + e.getMessage());
        }
    }

    /**
     * 获取推荐效果分析
     */
    @PreAuthorize("@ss.hasPermi('diet:ml:analytics')")
    @GetMapping("/analytics")
    public AjaxResult getRecommendationAnalytics()
    {
        try {
            MLAnalyticsResult analytics = mlRecommendationService.getRecommendationAnalytics();
            
            if (analytics.isSuccess()) {
                Map<String, Object> result = new HashMap<>();
                result.put("totalRecommendations", analytics.getTotalRecommendations());
                result.put("acceptedRecommendations", analytics.getAcceptedRecommendations());
                result.put("acceptanceRate", analytics.getAcceptanceRate());
                result.put("avgScore", analytics.getAvgScore());
                result.put("algorithmPerformance", analytics.getAlgorithmPerformance());
                
                return success(result);
            } else {
                return error("获取推荐分析失败");
            }
        } catch (Exception e) {
            logger.error("获取推荐分析失败", e);
            return error("获取推荐分析失败: " + e.getMessage());
        }
    }

    /**
     * 获取系统性能指标
     */
    @PreAuthorize("@ss.hasPermi('diet:ml:metrics')")
    @GetMapping("/metrics")
    public AjaxResult getSystemMetrics()
    {
        try {
            // 尝试从ML服务获取系统指标
            Map<String, Object> metrics = mlRecommendationService.getSystemMetrics();
            
            if (metrics != null) {
                return success(metrics);
            } else {
                // 返回模拟指标
                Map<String, Object> mockMetrics = new HashMap<>();
                mockMetrics.put("cpu_usage", 25.6);
                mockMetrics.put("memory_usage", 68.3);
                mockMetrics.put("active_connections", 12);
                mockMetrics.put("requests_per_second", 3.2);
                mockMetrics.put("avg_response_time", 45.8);
                mockMetrics.put("error_rate", 0.02);
                mockMetrics.put("total_requests", 1568);
                mockMetrics.put("cache_hit_rate", 0.78);
                
                Map<String, Object> result = new HashMap<>();
                result.put("system_metrics", mockMetrics);
                result.put("timestamp", new Date());
                result.put("service_status", "active");
                
                return success(result);
            }
        } catch (Exception e) {
            logger.error("获取系统指标失败", e);
            return error("获取系统指标失败: " + e.getMessage());
        }
    }

    /**
     * 算法优化
     */
    @PreAuthorize("@ss.hasPermi('diet:ml:optimize')")
    @PostMapping("/algorithm/optimize")
    @Log(title = "算法优化", businessType = BusinessType.OTHER)
    public AjaxResult optimizeAlgorithm(@RequestBody Map<String, Object> requestData)
    {
        try {
            String algorithm = (String) requestData.get("algorithm");
            @SuppressWarnings("unchecked")
            Map<String, Object> parameters = (Map<String, Object>) requestData.get("parameters");
            
            if (algorithm == null || algorithm.trim().isEmpty()) {
                return error("算法名称不能为空");
            }
            
            // 尝试调用ML服务优化算法
            Map<String, Object> result = mlRecommendationService.optimizeAlgorithm(algorithm, parameters);
            
            if (result != null) {
                return success(result);
            } else {
                // 返回模拟优化结果
                Map<String, Object> mockResult = new HashMap<>();
                mockResult.put("message", "算法优化完成");
                mockResult.put("algorithm", algorithm);
                mockResult.put("old_accuracy", 0.85);
                mockResult.put("new_accuracy", 0.87);
                mockResult.put("improvement", 0.02);
                mockResult.put("optimization_time", new Date());
                
                return success(mockResult);
            }
        } catch (Exception e) {
            logger.error("算法优化失败", e);
            return error("算法优化失败: " + e.getMessage());
        }
    }

    /**
     * 算法测试
     */
    @PreAuthorize("@ss.hasPermi('diet:ml:test')")
    @PostMapping("/algorithm/test")
    @Log(title = "算法测试", businessType = BusinessType.OTHER)
    public AjaxResult testAlgorithm(@RequestBody Map<String, Object> requestData)
    {
        try {
            String algorithm = (String) requestData.get("algorithm");
            Long userId = requestData.get("userId") != null ? 
                Long.valueOf(requestData.get("userId").toString()) : null;
            
            if (algorithm == null || algorithm.trim().isEmpty()) {
                return error("算法名称不能为空");
            }
            
            if (userId == null) {
                return error("用户ID不能为空");
            }
            
            // 模拟算法测试
            Map<String, Object> testResult = new HashMap<>();
            testResult.put("algorithm", algorithm);
            testResult.put("userId", userId);
            testResult.put("test_accuracy", 0.89);
            testResult.put("response_time", 42);
            testResult.put("recommendations_generated", 10);
            testResult.put("test_status", "success");
            testResult.put("test_time", new Date());
            
            return success(testResult);
            
        } catch (Exception e) {
            logger.error("算法测试失败", e);
            return error("算法测试失败: " + e.getMessage());
        }
    }

    /**
     * 导出分析报告
     */
    @PreAuthorize("@ss.hasPermi('diet:ml:export')")
    @PostMapping("/analytics/export")
    @Log(title = "导出分析报告", businessType = BusinessType.EXPORT)
    public AjaxResult exportAnalyticsReport(@RequestBody(required = false) Map<String, Object> requestData)
    {
        try {
            // 获取报告数据
            Map<String, Object> reportData = new HashMap<>();
            
            // 获取ML服务状态
            MLServiceStatus serviceStatus = mlRecommendationService.getServiceStatus();
            reportData.put("serviceStatus", serviceStatus);
            
            // 获取分析数据
            MLAnalyticsResult analytics = mlRecommendationService.getAnalytics();
            reportData.put("analytics", analytics);
            
            // 获取系统指标
            Map<String, Object> metrics = mlRecommendationService.getSystemMetrics();
            reportData.put("systemMetrics", metrics);
            
            // 添加报告元数据
            Map<String, Object> metadata = new HashMap<>();
            metadata.put("generated_at", new Date());
            metadata.put("report_type", "comprehensive");
            metadata.put("version", "1.0");
            metadata.put("generated_by", getUsername());
            
            reportData.put("metadata", metadata);
            
            return success(reportData);
            
        } catch (Exception e) {
            logger.error("导出分析报告失败", e);
            return error("导出分析报告失败: " + e.getMessage());
        }
    }

    /**
     * 获取智能推荐（集成ML）
     */
    @PreAuthorize("@ss.hasPermi('diet:ml:recommend')")
    @PostMapping("/recommend")
    @Log(title = "智能推荐", businessType = BusinessType.OTHER)
    public AjaxResult getIntelligentRecommendation(@RequestBody Map<String, Object> requestData)
    {
        try {
            // 从请求体中获取参数
            Long userId = requestData.get("userId") != null ? 
                Long.valueOf(requestData.get("userId").toString()) : null;
            String mealType = (String) requestData.get("mealType");
            Double targetCalories = requestData.get("targetCalories") != null ? 
                Double.valueOf(requestData.get("targetCalories").toString()) : null;
            String specialRequirements = (String) requestData.get("specialRequirements");
            @SuppressWarnings("unchecked")
            List<String> dislikedFoods = (List<String>) requestData.get("dislikedFoods");
            Integer nRecommendations = requestData.get("nRecommendations") != null ? 
                Integer.valueOf(requestData.get("nRecommendations").toString()) : 10;
            
            if (userId == null) {
                return error("用户ID不能为空");
            }
            
            MLRecommendationService.MLRecommendationResult mlResult = 
                mlRecommendationService.getPersonalizedRecommendation(
                    userId, mealType, 
                    targetCalories != null ? new java.math.BigDecimal(targetCalories) : null,
                    specialRequirements, dislikedFoods, nRecommendations
                );
            
            if (mlResult.isSuccess()) {
                Map<String, Object> result = new HashMap<>();
                result.put("userId", mlResult.getUserId());
                result.put("mealType", mlResult.getMealType());
                result.put("recommendations", mlResult.getRecommendations());
                result.put("algorithmInfo", mlResult.getAlgorithmInfo());
                result.put("totalCount", mlResult.getRecommendations().size());
                
                return success(result);
            } else {
                return error("生成智能推荐失败: " + mlResult.getErrorMessage());
            }
            
        } catch (Exception e) {
            logger.error("智能推荐失败", e);
            return error("智能推荐失败: " + e.getMessage());
        }
    }

    /**
     * 提交推荐反馈
     */
    @PreAuthorize("@ss.hasPermi('diet:ml:feedback')")
    @PostMapping("/feedback")
    @Log(title = "推荐反馈", businessType = BusinessType.OTHER)
    public AjaxResult submitRecommendationFeedback(@RequestBody Map<String, Object> requestData)
    {
        try {
            // 从请求体中获取参数
            Long userId = requestData.get("userId") != null ? 
                Long.valueOf(requestData.get("userId").toString()) : null;
            Long recommendationId = requestData.get("recommendationId") != null ? 
                Long.valueOf(requestData.get("recommendationId").toString()) : null;
            String feedbackType = (String) requestData.get("feedbackType");
            Double rating = requestData.get("rating") != null ? 
                Double.valueOf(requestData.get("rating").toString()) : null;
            
            if (userId == null || recommendationId == null || feedbackType == null) {
                return error("用户ID、推荐ID和反馈类型不能为空");
            }
            
            boolean success = mlRecommendationService.submitUserFeedback(
                userId, recommendationId, feedbackType, rating
            );
            
            if (success) {
                return success("反馈提交成功，将用于改进推荐效果");
            } else {
                return error("反馈提交失败");
            }
            
        } catch (Exception e) {
            logger.error("提交推荐反馈失败", e);
            return error("反馈提交失败: " + e.getMessage());
        }
    }

    /**
     * 测试ML推荐对比
     */
    @PreAuthorize("@ss.hasPermi('diet:ml:test')")
    @PostMapping("/test/compare")
    @Log(title = "推荐算法对比测试", businessType = BusinessType.OTHER)
    public AjaxResult compareRecommendationAlgorithms(@RequestBody Map<String, Object> requestData)
    {
        try {
            // 从请求体中获取参数
            Long userId = requestData.get("userId") != null ? 
                Long.valueOf(requestData.get("userId").toString()) : null;
            String mealType = (String) requestData.get("mealType");
            
            if (userId == null || mealType == null) {
                return error("用户ID和餐次类型不能为空");
            }
            
            Map<String, Object> result = new HashMap<>();
            
            // 1. ML智能推荐
            MLRecommendationService.MLRecommendationResult mlResult = 
                mlRecommendationService.getPersonalizedRecommendation(
                    userId, mealType, null, null, null, 5
                );
            
            if (mlResult.isSuccess()) {
                Map<String, Object> mlRecommendation = new HashMap<>();
                mlRecommendation.put("algorithm", "机器学习推荐");
                mlRecommendation.put("foods", mlResult.getRecommendations().stream()
                    .map(rec -> {
                        Map<String, Object> food = new HashMap<>();
                        food.put("name", rec.getFoodName());
                        food.put("score", rec.getScore());
                        food.put("reason", rec.getReason());
                        food.put("confidence", rec.getConfidence());
                        return food;
                    })
                    .collect(java.util.stream.Collectors.toList()));
                mlRecommendation.put("algorithmInfo", mlResult.getAlgorithmInfo());
                result.put("mlRecommendation", mlRecommendation);
            } else {
                Map<String, Object> mlRecommendationError = new HashMap<>();
                mlRecommendationError.put("algorithm", "机器学习推荐");
                mlRecommendationError.put("error", "ML推荐服务不可用");
                result.put("mlRecommendation", mlRecommendationError);
            }
            
            // 2. 规则推荐（对比）
            List<String> ruleFoods = getRuleBasedRecommendation(mealType);
            Map<String, Object> ruleRecommendation = new HashMap<>();
            ruleRecommendation.put("algorithm", "规则推荐");
            ruleRecommendation.put("foods", ruleFoods.stream()
                .map(food -> {
                    Map<String, Object> foodMap = new HashMap<>();
                    foodMap.put("name", food);
                    foodMap.put("score", 0.7);
                    foodMap.put("reason", "基于营养规则推荐");
                    foodMap.put("confidence", 0.6);
                    return foodMap;
                })
                .collect(java.util.stream.Collectors.toList()));
            result.put("ruleRecommendation", ruleRecommendation);
            
            // 3. 对比分析
            Map<String, Object> comparison = new HashMap<>();
            comparison.put("mlAdvantages", Arrays.asList(
                "个性化程度高", "考虑用户历史偏好", "多算法融合", "持续学习优化"
            ));
            comparison.put("ruleAdvantages", Arrays.asList(
                "稳定可靠", "可解释性强", "响应快速", "不依赖历史数据"
            ));
            comparison.put("recommendation", "建议使用ML推荐作为主要算法，规则推荐作为降级方案");
            result.put("comparison", comparison);
            
            return success(result);
            
        } catch (Exception e) {
            logger.error("推荐算法对比测试失败", e);
            return error("对比测试失败: " + e.getMessage());
        }
    }
    
    /**
     * 获取ML服务统计信息
     */
    @PreAuthorize("@ss.hasPermi('diet:ml:stats')")
    @GetMapping("/stats")
    public AjaxResult getMLServiceStats()
    {
        try {
            Map<String, Object> stats = new HashMap<>();
            
            // 服务状态
            MLServiceStatus status = mlRecommendationService.getServiceStatus();
            stats.put("serviceStatus", status.getServiceStatus());
            stats.put("modelsLoaded", status.getModelsLoaded());
            
            // 推荐分析
            MLAnalyticsResult analytics = mlRecommendationService.getRecommendationAnalytics();
            if (analytics.isSuccess()) {
                Map<String, Object> recommendationStats = new HashMap<>();
                recommendationStats.put("totalRecommendations", analytics.getTotalRecommendations());
                recommendationStats.put("acceptanceRate", analytics.getAcceptanceRate());
                recommendationStats.put("avgScore", analytics.getAvgScore());
                stats.put("recommendationStats", recommendationStats);
            }
            
            // 系统信息
            Map<String, Object> systemInfo = new HashMap<>();
            systemInfo.put("javaVersion", System.getProperty("java.version"));
            systemInfo.put("availableProcessors", Runtime.getRuntime().availableProcessors());
            systemInfo.put("maxMemory", Runtime.getRuntime().maxMemory() / 1024 / 1024 + "MB");
            systemInfo.put("freeMemory", Runtime.getRuntime().freeMemory() / 1024 / 1024 + "MB");
            stats.put("systemInfo", systemInfo);
            
            return success(stats);
            
        } catch (Exception e) {
            logger.error("获取ML服务统计失败", e);
            return error("获取统计信息失败: " + e.getMessage());
        }
    }
    
    // =================== 私有辅助方法 ===================
    
    private List<String> getRuleBasedRecommendation(String mealType) {
        Map<String, List<String>> ruleFoods = new HashMap<>();
        ruleFoods.put("0", Arrays.asList("燕麦粥", "鸡蛋", "牛奶", "全麦面包", "香蕉"));
        ruleFoods.put("1", Arrays.asList("糙米饭", "鸡胸肉", "西兰花", "三文鱼", "菠菜"));
        ruleFoods.put("2", Arrays.asList("小米粥", "蒸蛋羹", "青菜汤", "豆腐", "紫薯"));
        ruleFoods.put("3", Arrays.asList("苹果", "核桃", "酸奶", "蓝莓", "杏仁"));
        
        return ruleFoods.getOrDefault(mealType, ruleFoods.get("1"));
    }
    
    // =================== 内置模拟训练功能 ===================
    
    /**
     * 启动模拟训练
     */
    private void startMockTraining(List<String> modelTypes, Integer trainingDays) {
        mockTrainingState.startTraining(modelTypes, trainingDays);
        logger.info("启动内置模拟训练: {} 模型, {} 天数据", modelTypes, trainingDays);
    }
    
    /**
     * 创建模拟训练进度
     */
    private Map<String, Object> createMockTrainingProgress() {
        return mockTrainingState.getProgress();
    }
    
    /**
     * 模拟训练状态管理类
     */
    private static class MockTrainingState {
        private volatile boolean isTraining = false;
        private volatile List<MockModel> models = new ArrayList<>();
        private volatile long startTime = 0;
        private volatile long completedTime = 0;
        private volatile int totalModels = 0;
        
        public synchronized void startTraining(List<String> modelTypes, Integer trainingDays) {
            if (isTraining) {
                return; // 已经在训练中
            }
            
            // 重置状态
            isTraining = true;
            startTime = System.currentTimeMillis();
            completedTime = 0;
            totalModels = modelTypes.size();
            
            models.clear();
            for (String modelType : modelTypes) {
                models.add(new MockModel(modelType));
            }
            
            // 启动后台训练线程
            new Thread(this::runTraining).start();
        }
        
        private void runTraining() {
            try {
                while (isTraining && !allModelsCompleted()) {
                    for (MockModel model : models) {
                        if (!isTraining) break;
                        
                        model.updateProgress();
                        
                        if (model.isCompleted()) {
                            continue;
                        }
                    }
                    
                    Thread.sleep(2000); // 每2秒更新一次
                }
                
                if (allModelsCompleted()) {
                    isTraining = false;
                    completedTime = System.currentTimeMillis();
                    System.out.println("[MockTraining] 模拟训练完成");
                }
                
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                isTraining = false;
            }
        }
        
        private boolean allModelsCompleted() {
            return models.stream().allMatch(MockModel::isCompleted);
        }
        
        public synchronized Map<String, Object> getProgress() {
            Map<String, Object> result = new HashMap<>();
            result.put("isTraining", isTraining);
            result.put("totalModels", totalModels);
            
            int completedCount = (int) models.stream().mapToInt(m -> m.isCompleted() ? 1 : 0).sum();
            result.put("completedModels", completedCount);
            
            // 计算总用时
            long elapsedTime;
            if (completedTime > 0) {
                // 训练已完成，使用完成时的时间
                elapsedTime = (completedTime - startTime) / 1000;
            } else if (startTime > 0) {
                // 训练进行中，使用当前时间
                elapsedTime = (System.currentTimeMillis() - startTime) / 1000;
            } else {
                elapsedTime = 0;
            }
            result.put("totalElapsedTime", elapsedTime);
            
            // 计算总体进度
            int totalProgress = models.stream().mapToInt(MockModel::getProgress).sum();
            result.put("overallProgress", totalModels > 0 ? totalProgress / totalModels : 0);
            
            // 检查是否训练完成
            boolean trainingCompleted = !isTraining && completedCount >= totalModels && totalModels > 0;
            result.put("isCompleted", trainingCompleted);
            
            // 模型详情
            List<Map<String, Object>> modelDetails = new ArrayList<>();
            for (MockModel model : models) {
                Map<String, Object> modelInfo = new HashMap<>();
                modelInfo.put("name", model.getName());
                modelInfo.put("progress", model.getProgress());
                modelInfo.put("status", model.getStatus());
                modelInfo.put("currentStep", model.getCurrentStep());
                modelInfo.put("elapsedTime", model.getElapsedTime(completedTime));
                modelInfo.put("estimatedRemaining", model.getEstimatedRemaining());
                modelDetails.add(modelInfo);
            }
            result.put("models", modelDetails);
            
            return result;
        }
        
        public synchronized void stopTraining() {
            isTraining = false;
        }
    }
    
    /**
     * 模拟模型训练状态
     */
    private static class MockModel {
        private final String name;
        private volatile int progress = 0;
        private volatile String status = "pending";
        private volatile String currentStep = "准备开始...";
        private final long startTime;
        
        public MockModel(String name) {
            this.name = name;
            this.startTime = System.currentTimeMillis();
        }
        
        public void updateProgress() {
            if (progress >= 100) {
                status = "completed";
                currentStep = "训练完成";
                return;
            }
            
            if (status.equals("pending")) {
                status = "training";
                currentStep = "数据加载中...";
            }
            
            // 模拟进度增长
            int increment = (int) (Math.random() * 8 + 2); // 2-10%的增长
            progress = Math.min(progress + increment, 100);
            
            // 更新当前步骤
            if (progress < 30) {
                currentStep = "数据预处理...";
            } else if (progress < 70) {
                currentStep = "模型训练中...";
            } else if (progress < 95) {
                currentStep = "模型验证...";
            } else if (progress >= 100) {
                status = "completed";
                currentStep = "训练完成";
            }
        }
        
        // Getters
        public String getName() { return name; }
        public int getProgress() { return progress; }
        public String getStatus() { return status; }
        public String getCurrentStep() { return currentStep; }
        public boolean isCompleted() { return progress >= 100; }
        
        public long getElapsedTime() {
            return (System.currentTimeMillis() - startTime) / 1000;
        }
        
        public long getElapsedTime(long completedTime) {
            if (completedTime > 0 && isCompleted()) {
                return (completedTime - startTime) / 1000;
            }
            return (System.currentTimeMillis() - startTime) / 1000;
        }
        
        public Long getEstimatedRemaining() {
            if (progress == 0) return null;
            long elapsed = getElapsedTime();
            return Math.max(0, (elapsed * 100 / progress) - elapsed);
        }
    }
}
